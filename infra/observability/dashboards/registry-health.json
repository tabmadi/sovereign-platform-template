{
  "title": "Registry health",
  "uid": "registry-health",
  "schemaVersion": 39,
  "tags": [
    "platform",
    "registry",
    "etcd"
  ],
  "description": "Compare the external registry probe, registry replicas, node readiness, and etcd disk latency over one time range, per ADR-0500.",
  "links": [
    {
      "title": "Back to Overview",
      "type": "link",
      "url": "/d/overview/overview?${__url_time_range}",
      "icon": "external link"
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "state-timeline",
      "title": "External probe result",
      "description": "Green is a good response, red is a failed probe, and gray is unknown because the probe has no data.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "showValue": "never",
        "mergeValues": true
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Failed",
                  "color": "red"
                },
                "1": {
                  "text": "OK",
                  "color": "green"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{service_name=\"registry-probe\"} and on (instance) up{service_name=\"registry-probe\"} == 1",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Probe duration",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_duration_seconds{service_name=\"registry-probe\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Available registry replicas",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(k8s_deployment_available{service_namespace=\"platform\",service_name=\"zot\"})",
          "legendFormat": "available"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Node readiness",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "k8s_node_condition_ready",
          "legendFormat": "{{k8s_node_name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "etcd WAL fsync p99",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (instance, le) (rate(etcd_disk_wal_fsync_duration_seconds_bucket{service_name=\"etcd\"}[5m])))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "etcd backend commit p99",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (instance, le) (rate(etcd_disk_backend_commit_duration_seconds_bucket{service_name=\"etcd\"}[5m])))",
          "legendFormat": "{{instance}}"
        }
      ]
    }
  ]
}
