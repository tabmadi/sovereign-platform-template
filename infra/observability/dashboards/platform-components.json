{
  "title": "Platform components",
  "uid": "platform-components",
  "schemaVersion": 39,
  "tags": ["platform", "components"],
  "description": "Component-native metrics for the platform tier, per ADR-0501. Postgres reports through the built-in exporter of the CNPG instance manager on :9187, which includes the pgbouncer poolers. The Temporal server roles report on :9090. The otel-cluster collector scrapes them and exports them again over OTLP, so Prometheus itself still scrapes nothing, per ADR-0500. These are the REAL golden signals of the components, such as transactions and task latencies. They are not HTTP servers, so the service-detail SLO and RED panels would show false data for them. General health for the same workloads, such as pods, restarts, logs, and resources, is on service-detail.",
  "links": [
    {
      "title": "\u25c0 Back to Applications",
      "type": "link",
      "url": "/d/applications/applications?${__url_time_range}",
      "icon": "external link"
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "PostgreSQL, CNPG exporter",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Transactions/s by database",
      "description": "Commits and rollbacks per second for each database. This is postgres's request rate.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (datname) (rate(cnpg_pg_stat_database_xact_commit_total{service_name=\"postgres\"}[5m]) + rate(cnpg_pg_stat_database_xact_rollback_total{service_name=\"postgres\"}[5m]))",
          "legendFormat": "{{datname}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Backends by database",
      "description": "Open server connections for each database. The poolers keep this low and steady, in transaction mode, per ADR-0300. A climb here means that something bypasses pgbouncer or leaks connections.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (datname) (cnpg_backends_total{service_name=\"postgres\"})",
          "legendFormat": "{{datname}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cache hit ratio and deadlocks",
      "description": "Shared-buffers hit ratio on the left, which should be near 100%. Deadlocks per second on the right, which should be zero.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "deadlocks/s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ops"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "max",
                "value": null
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cnpg_pg_stat_database_blks_hit_total{service_name=\"postgres\"}[5m])) / (sum(rate(cnpg_pg_stat_database_blks_hit_total{service_name=\"postgres\"}[5m])) + sum(rate(cnpg_pg_stat_database_blks_read_total{service_name=\"postgres\"}[5m])))",
          "legendFormat": "cache hit ratio"
        },
        {
          "refId": "B",
          "expr": "sum(rate(cnpg_pg_stat_database_deadlocks_total{service_name=\"postgres\"}[5m]))",
          "legendFormat": "deadlocks/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "WAL write rate",
      "description": "Bytes of WAL generated per second. This is the write-load signal. With backups on, it is also what goes to the object store.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cnpg_collector_wal_bytes{service_name=\"postgres\"}[5m]))",
          "legendFormat": "WAL bytes/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Database size",
      "description": "On-disk size per database.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (datname) (cnpg_pg_database_size_bytes{service_name=\"postgres\"})",
          "legendFormat": "{{datname}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Longest transaction",
      "description": "The longest open transaction across backends. Long transactions block vacuum and bloat the poolers, because transaction mode holds a server connection for the whole transaction.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(cnpg_backends_max_tx_duration_seconds{service_name=\"postgres\"})",
          "legendFormat": "max tx duration"
        }
      ]
    },
    {
      "type": "row",
      "title": "Temporal server metrics",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "gRPC request rate by role",
      "description": "service_requests_total per second, split by server role. The per-role identity stays in the `type` label. otel-cluster drops the exporter's own service_name label to keep the workload identity whole.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (rate(service_requests_total{service_name=\"temporal\"}[5m]))",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Frontend latency p50, p95, p99",
      "description": "Client-facing gRPC latency at the frontend role. This is the D of Temporal's own RED. Long-poll operations are excluded. They block for about 60s by design and would distort the percentiles.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(service_latency_bucket{service_name=\"temporal\",type=\"frontend\",operation!~\"PollWorkflowTaskQueue|PollActivityTaskQueue|PollNexusTaskQueue|GetWorkflowExecutionHistory\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(service_latency_bucket{service_name=\"temporal\",type=\"frontend\",operation!~\"PollWorkflowTaskQueue|PollActivityTaskQueue|PollNexusTaskQueue|GetWorkflowExecutionHistory\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(service_latency_bucket{service_name=\"temporal\",type=\"frontend\",operation!~\"PollWorkflowTaskQueue|PollActivityTaskQueue|PollNexusTaskQueue|GetWorkflowExecutionHistory\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Persistence requests and errors",
      "description": "Temporal's calls into its postgres store. The error rate here, on the right axis, is the first place where database trouble shows.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "errors/s"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(persistence_requests_total{service_name=\"temporal\"}[5m]))",
          "legendFormat": "requests/s"
        },
        {
          "refId": "B",
          "expr": "sum(rate(persistence_errors_total{service_name=\"temporal\"}[5m])) or vector(0)",
          "legendFormat": "errors/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Workflow completions/s",
      "description": "Successfully completed workflow executions per second.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(workflow_success_total{service_name=\"temporal\"}[5m])) or vector(0)",
          "legendFormat": "workflow success/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Task schedule-to-start p95",
      "description": "How long tasks wait in matching queues before a worker picks them up. This is the signal for backlog and worker starvation. A rising p95 with a flat request rate means that there are too few workers.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(task_schedule_to_start_latency_bucket{service_name=\"temporal\"}[5m])))",
          "legendFormat": "p95 schedule-to-start"
        }
      ]
    },
    {
      "type": "row",
      "title": "Kyverno admission control",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Admission review latency p50, p95, p99",
      "description": "kyverno_admission_review_duration_seconds. This is time that the API SERVER spends waiting: every create and update in the cluster waits for it. The webhook timeout is 30s. For a review that reaches the timeout, the failurePolicy decides, and not the policy, per ADR-0104.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(kyverno_admission_review_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(kyverno_admission_review_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(kyverno_admission_review_duration_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Policy results by rule",
      "description": "kyverno_policy_results_total, split by policy, rule, and outcome. A `fail` here is an image that this platform refused to run: an unsigned build, a floating tag, or a registry that is not on the allow-list. Sustained fails mean that a pipeline makes images that the cluster will not accept.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (policy_name, rule_name, rule_result) (rate(kyverno_policy_results_total[5m]))",
          "legendFormat": "{{policy_name}}/{{rule_name}} {{rule_result}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Controller reconciles/s",
      "description": "kyverno_controller_reconcile_total by controller. The KyvernoAdmissionControllerAbsent alert fires on flat zero for every controller. A controller that does not run exports nothing. So absence is the signal, and not a threshold.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 43
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (controller_name) (rate(kyverno_controller_reconcile_total[5m]))",
          "legendFormat": "{{controller_name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Admission requests/s by operation",
      "description": "kyverno_admission_requests_total: the volume that the webhook carries. Read it next to the latency panel. Together, the two show how close the 30s timeout is.",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 43
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation) (rate(kyverno_admission_requests_total[5m]))",
          "legendFormat": "{{operation}}"
        }
      ]
    }
  ]
}
