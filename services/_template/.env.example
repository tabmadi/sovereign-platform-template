# Local inner-loop environment for `<service>`, per ADR-0200 and ADR-0205.
# Copy it to .env. `just server`, `just worker`, and your IDE's debugger read it.
# Rename the database below to match your service, and delete any block that you do not use.
#
# Before you start, port-forward the deps to localhost and run the migrations:
#   just dev-forward     # in a separate terminal, keep it running
#   just migrate         # once per schema change
#
# No cluster step is needed. `just server` declares the dependency components
# it needs. just starts cluster-up and exactly those components, and skips any that
# are already Ready, per ADR-0205 and ADR-0600.

# Port-forwarded local Postgres. Add a CREATE DATABASE for your service to
# infra/local/deps.yaml, and add a migrate loop entry to scripts/db-migrate.sh.
DATABASE_URL=postgres://dev:dev@localhost:5432/<service>?sslmode=disable

# OpenFGA, for libs/go/authz. The client dials on first use, but the key is required at startup.
# The lite deps run an in-memory OpenFGA with a fixed dev preshared key.
OPENFGA_API_URL=http://localhost:18080
OPENFGA_PRESHARED_KEY=dev

# Temporal, for libs/go/temporalmw. `just worker` requires it. Delete this block
# if your service has no cmd/worker.
TEMPORAL_HOST_PORT=localhost:7233
TEMPORAL_NAMESPACE=default

# Uncomment these when you run an OTel collector locally. The lite deps have none.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
