# OpenFGA authorization model for the platform, per ADR-0304.
# This DSL is the ONE source of truth. `mise run gen:authz-model` generates
# `model.json` from it, and CI `lint:authz` checks that they match.
# `fga model test` runs the assertions in `fga.yaml` against this model.

model
  schema 1.1

type user

type org
  relations
    define member: [user]
    define admin: [user]
    define read: member or admin
    define write: admin
    define manage: admin

type product
  relations
    define org: [org]
    define read: read from org
    define write: write from org

type order
  relations
    define org: [org]
    define owner: [user]
    define read: owner or write from org
    define write: owner or write from org

# A charge is payment's record that an order is paid. The people who can read
# that order can read the charge: the buyer and the owning org's admins. It is a
# relation to the order, not a copy of the order's relations. So a change to who
# can read an order always applies to the charge. The `charges` table already
# carries `order_id`, which is the tuple.
type charge
  relations
    define order: [order]
    define read: read from order

# Ops-tier authorization, per ADR-0306. A `group` models broad cohorts. The
# `operator` group gates the whole ops tier. Each operator dashboard is a
# `dashboard` resource: Hubble UI, Grafana, Argo, Temporal, console, SeaweedFS,
# and OpenFGA. The ops-tier Oathkeeper checks `dashboard:<tool>#view` with the
# `remote_json` authorizer. The authz endpoint requires `group:operator`
# membership AND the per-tool view grant. A non-operator gets nothing, and
# per-dashboard grants narrow access inside the tier.
type group
  relations
    define member: [user]

type dashboard
  relations
    define viewer: [user, group#member]
    define view: viewer

# The analytics panel, per ADR-0700. It is one type like `dashboard` above, not
# a second pattern. The panel is a route group on the product origin. The same
# Checker as the ops tier gates its pages.
#
# It is a separate type from `dashboard` because a marketing group grants it.
# This separation solves the placement problem. Marketing never gets an ops-tier
# account, never needs operator MFA, and never touches Grafana. The ops tier's
# least-authority rule stays intact.
type analytics_panel
  relations
    define viewer: [user, group#member]
    define view: viewer
