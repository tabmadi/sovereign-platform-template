# Local inner-loop environment for `authz`, per ADR-0200, ADR-0205, and ADR-0306.
# Copy it to .env. `mise run server` and your IDE's debugger read it.
#
# authz is the ops-tier edge authorizer, with no database and no worker. It needs
# OpenFGA. It needs Kratos only for the identity-listing endpoints.
#
# Before you start, port-forward the deps to localhost:
#   mise run dev:forward     # in a separate terminal, keep it running
#
# No cluster step is needed. `mise run server` declares the dependency components
# it needs. mise starts cluster:base and exactly those components, and skips any that
# are already Ready, per ADR-0205 and ADR-0600.

# OpenFGA, for libs/go/authz. The client dials on first use, but the key is required at startup.
# The dep:openfga stand-in runs in-memory with a fixed dev preshared key.
OPENFGA_API_URL=http://localhost:18080
OPENFGA_PRESHARED_KEY=dev

# Kratos identity admin API, behind the /identities endpoints that the admin console's
# Users page calls. Kratos is NOT in the lite deps. Only the full tier runs it, with
# `mise run cluster:up -- full`. Port-forward it there before you uncomment this:
#   kubectl -n platform port-forward svc/ory-kratos-admin 4434:80
# KRATOS_ADMIN_URL=http://localhost:4434

# An optional fine per-tool OpenFGA layer on top of the always-on coarse claim gate,
# per ADR-0306. It is off by default, so the coarse gate has no OpenFGA dependency.
# OPS_FINE_GRAINED=true

# Uncomment these when you run an OTel collector locally. The lite deps have none.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
