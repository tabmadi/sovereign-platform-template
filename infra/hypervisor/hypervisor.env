# The hypervisor that the project runs, per ADR-0200: one Proxmox VE host on a dedicated machine. Every value is a
# fact about the machine, and none is a secret. The node names and addresses are in infra/talos/inventory/<env>/nodes.yml.

# How a workstation reaches the host, as `user@host`. The key is the host's root login, and cloud-init gives it to each VM.
HYPERVISOR_SSH=root@198.51.100.2
# Empty uses the SSH agent.
SSH_KEY=
# The inventory whose nodes run here.
ENVIRONMENT=dev

# The storage that holds VM disks, and the LVM volume group under it. A disk is written in place as a raw volume.
STORAGE=vg0-thin
VOLUME_GROUP=vg0

# The routed public subnet, on a bridge with no port. Each public address is a NAT rule, not an interface on a VM.
PUBLIC_BRIDGE=vmbr1
PUBLIC_BRIDGE_ADDRESS=198.51.100.97/29
# The cluster edge, the forge, and the outbound mail source, per ADR-0305, ADR-0102, and ADR-0307. Empty skips the rule.
PUBLIC_EDGE=198.51.100.101
PUBLIC_FORGE=198.51.100.99
PUBLIC_MAIL=198.51.100.98
# The node ports that Traefik publishes, per ADR-0305.
EDGE_HTTP_NODEPORT=30080
EDGE_HTTPS_NODEPORT=30443

# The private network of every node and VM. It reaches the internet through NAT on this host.
PRIVATE_BRIDGE=vmbr2
PRIVATE_GATEWAY=10.0.10.1
PRIVATE_PREFIX=24
DHCP_RANGE=10.0.10.100,10.0.10.200
DNS_SERVERS=1.1.1.1,9.9.9.9

# Sizes, in cores, MB of memory, and GB of disk. A project sets them from its own measurement, per ADR-0204.
NODE_CORES=4
NODE_MEMORY=8192
NODE_DISK=60
FORGE_CORES=2
FORGE_MEMORY=4096
FORGE_DISK=40
RUNNER_CORES=4
RUNNER_MEMORY=16384
RUNNER_DISK=160

DEBIAN_IMAGE_URL=https://cloud.debian.org/images/cloud/trixie/latest/debian-13-genericcloud-amd64.qcow2
