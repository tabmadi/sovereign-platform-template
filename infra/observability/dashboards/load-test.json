{
  "title": "Load test",
  "uid": "load-test",
  "schemaVersion": 39,
  "tags": ["perf", "k6", "capacity"],
  "description": "Compares a k6 load run, per ADR-0601, with what it cost the cluster. It is OUTSIDE the L1-L3 triage funnel of ADR-0501, on purpose. That funnel diagnoses an unplanned incident. This dashboard reads a planned experiment. In every row, the left column is what the generator saw, and the right column is what the platform paid. It is empty unless a run is in progress or the time range covers one.",
  "links": [
    {
      "title": "◀ Applications",
      "type": "link",
      "url": "/d/applications/applications?${__url_time_range}",
      "icon": "external link"
    },
    {
      "title": "Service detail",
      "type": "link",
      "url": "/d/service-detail/service-detail?${__url_time_range}",
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "scenario",
        "label": "Scenario",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(k6_http_reqs_total, scenario)",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(k8s_pod_cpu_usage, service_namespace)",
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "description": "Defaults to All, unlike the `platform` default of the Applications dashboard. The edge, Traefik and Cilium, lives in kube-system. On the read path, it uses more CPU than any business service. A default of `platform` would hide the most useful row in the cost table below."
      },
      {
        "name": "service",
        "label": "Services under test",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(k8s_pod_cpu_usage{service_namespace=\"platform\"}, service_name)",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": ["catalog", "orders", "payment"],
          "value": ["catalog", "orders", "payment"]
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "The run: what the generator saw",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Throughput",
      "description": "Requests per second that the generator achieved. Compare it with the VU count below. If VUs climb while this stays flat, the system under test is the bottleneck. A stress run exists to find that knee.",
      "datasource": "Prometheus",
      "gridPos": { "h": 5, "w": 5, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "blue" }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(k6_http_reqs_total{scenario=~\"$scenario\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Error rate",
      "description": "Share of requests that k6 did not count as a success, with expected_response=false. This is the generator's view. It includes connection failures that the server never saw, so the server's own 5xx rate does not count them.",
      "datasource": "Prometheus",
      "gridPos": { "h": 5, "w": 5, "x": 5, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(k6_http_reqs_total{scenario=~\"$scenario\",expected_response=\"false\"}[$__rate_interval])) or vector(0)) / sum(rate(k6_http_reqs_total{scenario=~\"$scenario\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "p95 latency",
      "description": "95th percentile round-trip time, measured from the generator. So it includes edge routing and the Oathkeeper forward-auth hop, and not only the service's own handler time.",
      "datasource": "Prometheus",
      "gridPos": { "h": 5, "w": 5, "x": 10, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "ms", "decimals": 0 } },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(k6_http_req_duration_milliseconds_bucket{scenario=~\"$scenario\"}[$__rate_interval])))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Virtual users",
      "description": "Concurrent VUs that the profile drives now. test/perf/lib/config.js ramps them. This is the independent variable of the experiment.",
      "datasource": "Prometheus",
      "gridPos": { "h": 5, "w": 4, "x": 15, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "purple" }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [{ "refId": "A", "expr": "max(k6_vus{scenario=~\"$scenario\"})" }]
    },
    {
      "type": "stat",
      "title": "Dropped iterations",
      "description": "Iterations that k6 could not start on time. NON-ZERO MEANS THAT THE GENERATOR IS THE BOTTLENECK, and not the platform. Every number on this dashboard is then too low. The run needs the k6-operator Scale swap in docs/operational-surface.md before anyone can trust it.",
      "datasource": "Prometheus",
      "gridPos": { "h": 5, "w": 5, "x": 19, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(k6_dropped_iterations_total{scenario=~\"$scenario\"}[$__range])) or vector(0)"
        }
      ]
    },
    {
      "type": "row",
      "title": "Load over time",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }
    },
    {
      "type": "timeseries",
      "title": "Throughput and concurrency",
      "description": "Requests per second for each endpoint, against the VU ramp. Look for this shape: throughput follows VUs in a line, then goes flat. The point where it goes flat is the capacity knee.",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "VUs" },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              { "id": "unit", "value": "short" },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [8, 4],
                  "fill": "dash"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{endpoint}}",
          "expr": "sum by (endpoint) (rate(k6_http_reqs_total{scenario=~\"$scenario\"}[$__rate_interval]))"
        },
        {
          "refId": "B",
          "legendFormat": "VUs",
          "expr": "max(k6_vus{scenario=~\"$scenario\"})"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency percentiles by endpoint",
      "description": "p50, p95, and p99 for each endpoint. Watch the SPREAD, and not only p95. If p99 moves away from p50 while throughput is flat, requests are queueing. Queueing is what saturation looks like before it shows as errors.",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "fillOpacity": 0, "showPoints": "never" }
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p50 {{endpoint}}",
          "expr": "histogram_quantile(0.50, sum by (le, endpoint) (rate(k6_http_req_duration_milliseconds_bucket{scenario=~\"$scenario\"}[$__rate_interval])))"
        },
        {
          "refId": "B",
          "legendFormat": "p95 {{endpoint}}",
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(k6_http_req_duration_milliseconds_bucket{scenario=~\"$scenario\"}[$__rate_interval])))"
        },
        {
          "refId": "C",
          "legendFormat": "p99 {{endpoint}}",
          "expr": "histogram_quantile(0.99, sum by (le, endpoint) (rate(k6_http_req_duration_milliseconds_bucket{scenario=~\"$scenario\"}[$__rate_interval])))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Checkout saga: settle time and outcome",
      "description": "The async half of the write path, per ADR-0302. p95 settle is the wall time from an accepted checkout to a terminal order. So it measures Temporal throughput, and not API latency. A falling confirmed rate while the POST stays fast is the typical failure of an async system under load. The API accepts work that the workers cannot finish in time. Empty for the browse scenario.",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*rate.*"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "percentunit"
              },
              { "id": "max", "value": 1 },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p95 settle",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(k6_checkout_settle_milliseconds_bucket[$__rate_interval])))"
        },
        {
          "refId": "B",
          "legendFormat": "p50 settle",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(k6_checkout_settle_milliseconds_bucket[$__rate_interval])))"
        },
        {
          "refId": "C",
          "legendFormat": "confirmed rate",
          "expr": "(sum(rate(k6_checkout_confirmed_total{condition=\"nonzero\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(k6_checkout_confirmed_total[$__rate_interval])), 0.001)"
        },
        {
          "refId": "D",
          "legendFormat": "timeout rate",
          "expr": "(sum(rate(k6_checkout_timeout_total{condition=\"nonzero\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(k6_checkout_timeout_total[$__rate_interval])), 0.001)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Server-side latency, for comparison",
      "description": "The same requests, as the platform's own instrumentation saw them, from the ADR-0500 metric http_server_request_duration_seconds. The GAP between this and the generator's p95 on the other side is time in the edge, in TLS, and in the network. If the gap grows under load, Traefik or Oathkeeper is the constraint, and not the service.",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 0, "showPoints": "never" }
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p95 {{service_name}}",
          "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(http_server_request_duration_seconds_bucket{service_name=~\"$service\"}[$__rate_interval])))"
        }
      ]
    },
    {
      "type": "row",
      "title": "The bill: what the cluster paid for it",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }
    },
    {
      "type": "table",
      "title": "Cost per workload over this window, sorted by peak CPU",
      "description": "Every workload in the cluster, ranked by what this run cost it. Rows are per DEPLOYMENT or StatefulSet, and not per service. `service_name` puts all six Temporal components into one row, and orders-server and orders-worker into another. That hides the finding: under checkout load, the expensive workload is temporal-history, at nearly 2 cores. PromQL derives the `workload` label as the deployment name, else the statefulset name, else the folded service_name. Peak comes before mean, because you size for the peak: a container is OOM-killed at its peak, not at its mean. It is NOT filtered to the services under test, on purpose. The interesting answer is usually a workload that nobody tested. Under read load, the top two rows were Oathkeeper and Traefik, and not catalog. The ingress and forward-auth hop costs about 3x the business logic behind it. There are no RED columns here, on purpose. http.server metrics have per-service labels and cannot join to per-deployment rows. For req/s and errors per service, use Overview or Applications. This adds to the Applications dashboard, and does not repeat it. That dashboard shows how big each workload is now. This one shows what THIS experiment cost, over the selected range. IMPORTANT: this is working_set divided by the container limit. It is computed here, and not read from kubeletstats' k8s_pod_memory_limit_utilization_ratio. That metric divides memory.USAGE by the limit, and usage includes page cache that can be reclaimed. Measured, it overstated 2 to 3x across every pod: otel-cluster reported 97.9% against a real 58.0%. The OOM killer acts on the working set, so size a limit against the working set. Only containers that declare a memory limit appear. A blank row is itself an ADR-0204 finding.",
      "datasource": "Prometheus",
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 24 },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "CPU peak", "desc": true }]
      },
      "fieldConfig": {
        "defaults": { "decimals": 3 },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "CPU.*" },
            "properties": [{ "id": "unit", "value": "none" }]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Memory peak"
            },
            "properties": [{ "id": "unit", "value": "bytes" }, { "id": "decimals", "value": 0 }]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Mem % of limit"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              { "id": "max", "value": 1 },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 0.75
                    },
                    {
                      "color": "red",
                      "value": 0.9
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Restarts" },
            "properties": [
              { "id": "decimals", "value": 0 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-text" }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false,
          "expr": "max_over_time((sum by (workload) (label_replace(label_replace(label_replace(k8s_pod_cpu_usage{service_namespace=~\"$namespace\"}, \"workload\", \"$1\", \"service_name\", \"(.*)\"), \"workload\", \"$1\", \"k8s_deployment_name\", \"(.+)\"), \"workload\", \"$1\", \"k8s_statefulset_name\", \"(.+)\")))[$__range:15s])"
        },
        {
          "refId": "B",
          "format": "table",
          "instant": true,
          "range": false,
          "expr": "avg_over_time((sum by (workload) (label_replace(label_replace(label_replace(k8s_pod_cpu_usage{service_namespace=~\"$namespace\"}, \"workload\", \"$1\", \"service_name\", \"(.*)\"), \"workload\", \"$1\", \"k8s_deployment_name\", \"(.+)\"), \"workload\", \"$1\", \"k8s_statefulset_name\", \"(.+)\")))[$__range:15s])"
        },
        {
          "refId": "C",
          "format": "table",
          "instant": true,
          "range": false,
          "expr": "max_over_time((sum by (workload) (label_replace(label_replace(label_replace(k8s_pod_memory_working_set_bytes{service_namespace=~\"$namespace\"}, \"workload\", \"$1\", \"service_name\", \"(.*)\"), \"workload\", \"$1\", \"k8s_deployment_name\", \"(.+)\"), \"workload\", \"$1\", \"k8s_statefulset_name\", \"(.+)\")))[$__range:15s])"
        },
        {
          "refId": "D",
          "format": "table",
          "instant": true,
          "range": false,
          "expr": "max_over_time((max by (workload) (label_replace(label_replace(label_replace(k8s_pod_memory_working_set_bytes{service_namespace=~\"$namespace\"} / on(instance) group_left k8s_container_memory_limit_bytes, \"workload\", \"$1\", \"service_name\", \"(.*)\"), \"workload\", \"$1\", \"k8s_deployment_name\", \"(.+)\"), \"workload\", \"$1\", \"k8s_statefulset_name\", \"(.+)\")))[$__range:15s])"
        },
        {
          "refId": "E",
          "format": "table",
          "instant": true,
          "range": false,
          "expr": "sum by (workload) (label_replace(label_replace(label_replace(increase(k8s_container_restarts{service_namespace=~\"$namespace\"}[$__range]), \"workload\", \"$1\", \"service_name\", \"(.*)\"), \"workload\", \"$1\", \"k8s_deployment_name\", \"(.+)\"), \"workload\", \"$1\", \"k8s_statefulset_name\", \"(.+)\"))"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "workload", "mode": "outer" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true
            },
            "renameByName": {
              "workload": "Workload",
              "Value #A": "CPU peak",
              "Value #B": "CPU mean",
              "Value #C": "Memory peak",
              "Value #D": "Mem % of limit",
              "Value #E": "Restarts"
            },
            "indexByName": {
              "workload": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5
            }
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Pod CPU",
      "description": "kubeletstats CPU per pod for the services under test. Read it with the latency panels above. If latency rises while CPU is flat, the constraint is not CPU. It is usually the connection pool or a lock.",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 35 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 3,
          "custom": { "fillOpacity": 10, "showPoints": "never" }
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{workload}}",
          "expr": "sum by (workload) (label_replace(label_replace(label_replace(k8s_pod_cpu_usage{service_namespace=\"platform\",service_name=~\"$service\"}, \"workload\", \"$1\", \"service_name\", \"(.*)\"), \"workload\", \"$1\", \"k8s_deployment_name\", \"(.+)\"), \"workload\", \"$1\", \"k8s_statefulset_name\", \"(.+)\"))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Pod memory, working set",
      "description": "Memory that cannot be reclaimed under pressure. The OOM killer acts on this number. A line that climbs through a soak run and never comes back down is the leak signal.",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 35 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "fillOpacity": 10, "showPoints": "never" }
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{workload}}",
          "expr": "sum by (workload) (label_replace(label_replace(label_replace(k8s_pod_memory_working_set_bytes{service_namespace=\"platform\",service_name=~\"$service\"}, \"workload\", \"$1\", \"service_name\", \"(.*)\"), \"workload\", \"$1\", \"k8s_deployment_name\", \"(.+)\"), \"workload\", \"$1\", \"k8s_statefulset_name\", \"(.+)\"))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory headroom against limit",
      "description": "Fraction of each container's memory limit in use, per ADR-0204. Crossing 1.0 is an OOM kill, so this panel turns a load run into a sizing decision. IMPORTANT: this is working_set divided by the container limit. It is computed here, and not read from kubeletstats' k8s_pod_memory_limit_utilization_ratio. That metric divides memory.USAGE by the limit, and usage includes page cache that can be reclaimed. Measured, it overstated 2 to 3x across every pod: otel-cluster reported 97.9% against a real 58.0%. The OOM killer acts on the working set, so size a limit against the working set. Only containers that declare a memory limit appear. A blank row is itself an ADR-0204 finding.",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 35 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{workload}}",
          "expr": "max by (workload) (label_replace(label_replace(label_replace(k8s_pod_memory_working_set_bytes{service_namespace=\"platform\",service_name=~\"$service\"} / on(instance) group_left k8s_container_memory_limit_bytes, \"workload\", \"$1\", \"service_name\", \"(.*)\"), \"workload\", \"$1\", \"k8s_deployment_name\", \"(.+)\"), \"workload\", \"$1\", \"k8s_statefulset_name\", \"(.+)\"))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Node ceiling",
      "description": "Whole-node CPU and memory. On the local tier, the k6 generator ALSO runs on this host, but outside the kind node container. So it is not counted here. That is why local numbers are a regression signal and not a capacity figure, per ADR-0601.",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 43 },
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 10, "showPoints": "never" } },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "memory used"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              { "id": "unit", "value": "bytes" }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "CPU cores used",
          "expr": "sum(k8s_node_cpu_usage)"
        },
        {
          "refId": "B",
          "legendFormat": "memory used",
          "expr": "sum(k8s_node_memory_working_set_bytes)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Data tier under load",
      "description": "Postgres commit throughput and Temporal's schedule-to-start lag. A climbing schedule-to-start is the clearest Temporal saturation signal. Tasks are queued, and no worker has picked them up. It shows as slow checkouts long before any HTTP error.",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 43 },
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 0, "showPoints": "never" } },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*schedule.*"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              { "id": "unit", "value": "s" }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "postgres txn/s",
          "expr": "sum(rate(cnpg_pg_stat_database_xact_commit_total{service_name=\"postgres\"}[$__rate_interval]) + rate(cnpg_pg_stat_database_xact_rollback_total{service_name=\"postgres\"}[$__rate_interval]))"
        },
        {
          "refId": "B",
          "legendFormat": "temporal schedule-to-start p95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(task_schedule_to_start_latency_bucket{service_name=\"temporal\"}[$__rate_interval])))"
        }
      ]
    }
  ]
}
