# Local inner-loop environment for `orgs`, per ADR-0200 and ADR-0205.
# Copy it to .env. `mise run server`, `mise run worker`, and your IDE's debugger read it.
#
# Before you start, port-forward the deps to localhost and run the migrations:
#   mise run dev:forward     # in a separate terminal, keep it running
#   mise run migrate         # once per schema change
#
# No cluster step is needed. `mise run server` declares the dependency components
# it needs. mise starts cluster:base and exactly those components, and skips any that
# are already Ready, per ADR-0205 and ADR-0600.

# Port-forwarded local Postgres, from infra/local/deps.yaml.
DATABASE_URL=postgres://dev:dev@localhost:5432/orgs?sslmode=disable

# OpenFGA, for libs/go/authz. The client dials on first use, but the key is required at startup.
# The lite deps run an in-memory OpenFGA with a fixed dev preshared key.
OPENFGA_API_URL=http://localhost:18080
OPENFGA_PRESHARED_KEY=dev

# Temporal, for libs/go/temporalmw. `mise run worker` requires it to run the
# create-personal-org dual-write after registration, per ADR-0304.
TEMPORAL_HOST_PORT=localhost:7233
TEMPORAL_NAMESPACE=default

# Uncomment these when you run an OTel collector locally. The lite deps have none.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
