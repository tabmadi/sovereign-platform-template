# The forge host, per ADR-0102. Every value is a fact about a machine, and none is a secret.
# forge.sh reads this file. A project on its own hypervisor reaches the forge through that host.

# How a workstation reaches the forge machine, as `user@host`.
FORGE_SSH=root@10.0.10.30
# Empty when the workstation reaches the forge directly. On a private network, the host that reaches it.
FORGE_JUMP=root@198.51.100.2
# The key for both hops. Empty uses the SSH agent.
SSH_KEY=

# The public name of the forge. Its certificate comes from Forgejo's own ACME client.
FORGE_DOMAIN=forge.example.com
# The address that receives the ACME account mail.
ACME_EMAIL=ops@example.com

# renovate: datasource=docker depName=codeberg.org/forgejo/forgejo
FORGEJO_VERSION=16.0.2

# The organisation that owns the repository, so the repository URL names no person.
FORGE_ORG=platform
# A push mirror of the repository, such as `ssh://git@github.com/acme/acmeplat.git`. Empty means no mirror.
MIRROR_URL=
