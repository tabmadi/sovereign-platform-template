# The recipes of the template scope, per TPL-0000.

# Check that the project docs stay true in every copy
lint-scope:
    nix build ".#checks.$(nix eval --raw --impure --expr builtins.currentSystem).lint-scope" --no-link --print-build-logs

# Make a project from each fixture with just init, and check the refusals of the validator
test-template: in-shell
    bash template/test-template.sh

# Prove that a generated project serves. Set ACCEPTANCE_PROXY_ONLY=1 on a runner with direct public egress blocked
template-acceptance: in-shell
    bash template/acceptance.sh
