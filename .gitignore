# Editors
.idea/
*.iml
.run/
.vscode/
.history
*~
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Env files. Never commit a real secret, per ADR-0202. An encrypted .enc.yaml is allowed.
.env
.env.*
!.env.example

# Go
/bin/
/dist/
*.test
*.out
coverage.*

# Node and Bun
node_modules/
.next/
out/
.bun/
*.tsbuildinfo

# Biome, per ADR-0400
.biome/

# Playwright e2e, per ADR-0400 and ADR-0601
playwright-report/
test-results/
# Lighthouse CI output: the HTML and JSON reports and the lhci state directory.
# CI uploads them as an artifact. Locally they are noise.
lighthouse-report/
.lighthouseci/
blob-report/
# Saved auth storage states from the e2e setup project. They hold session cookies.
test/e2e/.auth/

# k6 load-run summaries, per ADR-0601. They are evidence for a PR or a CI artifact, not repo content.
# A committed summary is out of date the next day.
test/perf/results/

# Helm and Terraform
**/charts/*.tgz
# The exception: charts with no `dependencies:` that vendor their subcharts instead.
# The ArgoCD repo-server then renders them with no network fetch, which hangs behind the local privoxy edge.
# Each chart records the reason in its own Chart.yaml.
!infra/helm/platform/observability/charts/*.tgz
!infra/helm/platform/otel-agent/charts/*.tgz
# `helm dependency update` unpacks into `tmpcharts-<pid>/` next to the chart.
# It leaves the directory when the download fails. It is scratch, never content.
**/tmpcharts-*/
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
core.*


# Mise local cache
.mise.local.toml

# Rumble cache
.rumdl_cache

# Compiled Go binaries at the repo root. `go build ./tools/<name>` with no -o writes a binary named after the package into the CWD.
# Every tool runs with `go run`, as the lint tasks in .mise.toml show, so a built binary is scratch.
/lint-*
/gen-*
/data-classes
/zod-gen

# Local working files. They are never committed, per AGENTS.md.
*.local.md

# proxy:setup writes these. They hold this machine's egress route into the cluster.
infra/local/proxy.local.yaml
infra/local/proxy.local.env
