{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/dist",
      "!**/build",
      "!**/libs/ts/sdks",
      "!**/apps/admin/_generated",
      // Generated by scripts/gen-openapi-public.sh (the merged devportal spec
      // projections) — drift-checked by ci:gen, not hand-edited.
      "!**/apps/frontend/public/devportal",
      // The test/e2e/ Playwright workspace is the sanctioned Node island (ADR-0601) with
      // its own toolchain; the frontend-tuned React preset does not apply to it
      // (it is type-checked by its own tsconfig + the Playwright compile).
      "!**/test/e2e"
    ]
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      // Every Biome rule (incl. nursery), minus the ones that fight Next.js or the ADRs.
      "preset": "all",
      "correctness": {
        // Resolver can't see Next 16 type-only re-exports from next/server.
        "noUnresolvedImports": "off",
        // Route files and the design catalogue carry literal ids so a <Label> can
        // point at its control; these are authored markup, not generated ids.
        "useUniqueElementIds": "off",
        // Qwik-only rule; this is a React app (ADR-0400).
        "useQwikValidLexicalScope": "off",
        // Bundler resolves path aliases and extensionless specifiers.
        "useImportExtensions": "off",
        "noProcessGlobal": "off"
      },
      "performance": {
        // Solid.js-only rule; this is a React app (ADR-0400).
        "useSolidForComponent": "off",
        // radix-ui is consumed as one package, the way shadcn/ui generates it.
        "noBarrelFile": "off"
      },
      "suspicious": {
        // Solid.js-only rule; this is a React app (ADR-0400).
        "noReactSpecificProps": "off"
      },
      "style": {
        // Inline copy is a merge blocker (ADR-0400): every string a reader sees
        // comes from src/messages/. This rule is the half of that with a parser —
        // it sees a JSX text node the formatter wrapped across lines, and copy
        // passed as an attribute, neither of which a regex can recognise.
        // Catalogue parity and mirroring are `lint:i18n`.
        "noJsxLiterals": "error",
        "noProcessEnv": "off",
        // ADR-0303 snake_case fields + Next.js SCREAMING_SNAKE env keys.
        "useNamingConvention": "off",
        // Colour literals live in the token file alone (src/styles/theme.css).
        "noHexColors": "off",
        "useGlobalThis": "off",
        // Next.js declares `metadata` atop route files.
        "useExportsLast": "off",
        "noMagicNumbers": "off",
        "noImplicitBoolean": "off",
        "noTernary": "off",
        // `type` for object shapes; the one Window-augmentation interface carries a biome-ignore.
        "useConsistentTypeDefinitions": { "level": "error", "options": { "style": "type" } },
        // Next.js route files co-export route-segment config beside the component:
        // metadata/viewport describe the document, and dynamic/revalidate/
        // fetchCache/runtime describe how the segment renders. Both are Next's API
        // rather than stray exports, and a route that must not be statically
        // rendered — an authorization boundary, say — says so with `dynamic`.
        "useComponentExportOnlyModules": {
          "level": "error",
          "options": {
            "allowExportNames": [
              "metadata",
              "generateMetadata",
              "viewport",
              "generateViewport",
              "dynamic",
              "revalidate",
              "fetchCache",
              "runtime"
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      // libs/ts/id is a bit-level codec: it packs a 128-bit value into 26 base32
      // characters five bits at a time (ADR-0003). Bitwise operators and an index
      // counter ARE the domain here, and the rules banning them exist to keep them
      // out of React code, which this is not. The published alphabet and the TypeID
      // conformance vectors also read as high-entropy strings to the secret scanner.
      "includes": ["**/libs/ts/id/**"],
      "linter": {
        "rules": {
          "suspicious": { "noBitwiseOperators": "off" },
          "style": { "noIncrementDecrement": "off" },
          "security": { "noSecrets": "off" }
        }
      }
    },
    {
      // App Router route segments and config files use default exports, and a route
      // file's `generateStaticParams` / `generateMetadata` are exported functions
      // beside its component by Next's own contract.
      "includes": ["**/app/**", "**/*.config.{js,cjs,mjs,ts}"],
      "linter": {
        "rules": {
          "style": { "noDefaultExport": "off", "useComponentExportOnlyModules": "off" }
        }
      }
    },
    {
      // The data seam (ADR-0701). A screen states what it needs; `lib/data/` decides
      // whether that is the generated SDK or a committed fixture. Without this rule
      // the first page to wire `server-fetch` directly can never be designed against
      // a fixture again, and the seam decays into a convention nobody can see.
      // The three route-group overrides below restate it, because a later override
      // replaces this rule rather than adding to it.
      "includes": ["**/apps/frontend/src/app/**", "**/apps/frontend/src/components/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/lib/server-fetch/*", "@/fixtures/*", "@sdks/*"],
                    "message": "data reaches a screen through @/lib/data/ (ADR-0701); a page must not choose between the generated SDK and a fixture"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // Route-group isolation (ADR-0101): a route group does not import from
      // another. The groups are separate surfaces with separate trust tiers
      // (ADR-0306) — a shared component that both need belongs in components/ or
      // lib/, where the sharing is visible, rather than reaching across a boundary
      // that the URL, the layout and the auth gate all treat as one.
      "includes": ["**/app/(landing)/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/lib/server-fetch/*", "@/fixtures/*", "@sdks/*"],
                    "message": "data reaches a screen through @/lib/data/ (ADR-0701); a page must not choose between the generated SDK and a fixture"
                  },
                  {
                    "group": ["**/app/(panel)/**", "**/app/(devportal)/**"],
                    "message": "route groups do not import from each other (ADR-0101); share through components/ or lib/"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // Route-group isolation (ADR-0101): a route group does not import from
      // another. The groups are separate surfaces with separate trust tiers
      // (ADR-0306) — a shared component that both need belongs in components/ or
      // lib/, where the sharing is visible, rather than reaching across a boundary
      // that the URL, the layout and the auth gate all treat as one.
      "includes": ["**/app/(panel)/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/lib/server-fetch/*", "@/fixtures/*", "@sdks/*"],
                    "message": "data reaches a screen through @/lib/data/ (ADR-0701); a page must not choose between the generated SDK and a fixture"
                  },
                  {
                    "group": ["**/app/(landing)/**", "**/app/(devportal)/**"],
                    "message": "route groups do not import from each other (ADR-0101); share through components/ or lib/"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // Route-group isolation (ADR-0101): a route group does not import from
      // another. The groups are separate surfaces with separate trust tiers
      // (ADR-0306) — a shared component that both need belongs in components/ or
      // lib/, where the sharing is visible, rather than reaching across a boundary
      // that the URL, the layout and the auth gate all treat as one.
      "includes": ["**/app/(devportal)/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/lib/server-fetch/*", "@/fixtures/*", "@sdks/*"],
                    "message": "data reaches a screen through @/lib/data/ (ADR-0701); a page must not choose between the generated SDK and a fixture"
                  },
                  {
                    "group": ["**/app/(landing)/**", "**/app/(panel)/**"],
                    "message": "route groups do not import from each other (ADR-0101); share through components/ or lib/"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // The design catalogue (ADR-0400) is a developer tool behind the devportal
      // session gate. Its labels name primitives and demonstrate states — "Outline",
      // "Trialling", a swatch's token path — so they are not product copy and are
      // English by decision rather than by omission. Translating them would put ~75
      // keys a reader never sees into every catalogue.
      "includes": ["**/devportal/kitchen-sink/**"],
      "linter": { "rules": { "style": { "noJsxLiterals": "off" } } }
    },
    {
      // next-intl's request configuration is loaded by the plugin BY PATH, so its
      // shape is upstream's contract: one default export, and no component in the
      // module. Both rules exist to keep route files predictable, which this is not.
      "includes": ["**/apps/frontend/src/i18n/request.ts"],
      "linter": {
        "rules": {
          "style": { "noDefaultExport": "off", "useComponentExportOnlyModules": "off" }
        }
      }
    },
    {
      // Fixtures carry wire identifiers (ADR-0003) — 26 base32 characters, which is
      // what an id looks like and also what the secret scanner's entropy heuristic
      // looks for. gitleaks still scans these files (lint:secrets), so the coverage
      // that matters is not lost here.
      "includes": ["**/apps/frontend/src/fixtures/**"],
      "linter": { "rules": { "security": { "noSecrets": "off" } } }
    },
    {
      // Writes to stdout via console before slog/OTLP wiring.
      "includes": ["**/apps/frontend/src/lib/observability/server.ts"],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    },
    {
      // Vendored shadcn/ui source (ADR-0400): committed third-party primitives and
      // the token CSS, kept verbatim from upstream so `shadcn add` and a yearly bump
      // stay clean diffs rather than rewrites. Not held to the first-party
      // lint/format rules; tsc still type-checks them.
      "includes": [
        "**/apps/frontend/src/components/ui/**",
        "**/apps/frontend/src/utils/is-react-component.ts",
        "**/apps/frontend/src/styles/theme.css",
        "**/apps/frontend/src/styles/globals.css"
      ],
      "linter": { "enabled": false },
      "formatter": { "enabled": false },
      // Import order too: upstream's own order is what makes the next `shadcn add`
      // a no-op diff, and re-sorting it would put every component in the next bump.
      "assist": { "enabled": false }
    },
    {
      // k6 load scenarios (ADR-0601). Formatted like the rest of the repo, but four
      // rules are structurally impossible for a k6 script to satisfy — they are
      // disabled here rather than excluding test/perf/ wholesale (as test/e2e/ is), so every
      // OTHER rule still catches real bugs in scenario code.
      "includes": ["**/test/perf/**"],
      "linter": {
        "rules": {
          "correctness": {
            // `k6/http`, `k6/metrics`, … are engine builtins resolved by k6 itself.
            // There is no package.json to declare them in, and there must not be.
            "noUndeclaredDependencies": "off",
            // `__ENV` is k6's environment global.
            "noUndeclaredVariables": "off"
          },
          // A scenario's entrypoint is `export default function` — k6's contract,
          // not a style choice.
          "style": { "noDefaultExport": "off" },
          // console is the only output channel inside the k6 VM; there is no slog
          // and no OTLP logger to reach for (ADR-0500's rule addresses services).
          "suspicious": { "noConsole": "off" }
        }
      }
    },
    {
      // Canonical Oathkeeper access rules (ADR-0304): hand-curated one-rule-per-line
      // for readability and consumed verbatim as a Helm --set-file string. Biome's
      // JSON formatter collapses it to one line — never format this artefact.
      "includes": ["**/infra/auth/oathkeeper/access-rules.json"],
      "formatter": { "enabled": false }
    }
  ]
}
