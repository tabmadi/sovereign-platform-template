# Local inner-loop environment for `orders`, per ADR-0200 and ADR-0205.
# Copy it to .env. `mise run server`, `mise run worker`, and your IDE's debugger read it.
#
# Before you start, port-forward the deps to localhost and run the migrations:
#   mise run dev:forward     # in a separate terminal, keep it running
#   mise run migrate         # once per schema change
#
# No cluster step is needed. `mise run server` declares the dependency components
# it needs. mise starts cluster:base and exactly those components, and skips any that
# are already Ready, per ADR-0205 and ADR-0600.

# Port-forwarded local Postgres, from infra/local/deps.yaml.
DATABASE_URL=postgres://dev:dev@localhost:5432/orders?sslmode=disable

# OpenFGA, for libs/go/authz. The client dials on first use, but the key is required at startup.
# The lite deps run an in-memory OpenFGA with a fixed dev preshared key.
OPENFGA_API_URL=http://localhost:18080
OPENFGA_PRESHARED_KEY=dev

# Temporal, for libs/go/temporalmw. `mise run worker` requires it to run the
# checkout saga, per ADR-0302.
TEMPORAL_HOST_PORT=localhost:7233
TEMPORAL_NAMESPACE=default

# The checkout saga calls catalog and payment over HTTP, per ADR-0302. In the cluster,
# they resolve by DNS. A native worker cannot do that, so these point at their
# registered local ports from scripts/lib/ports.sh.
#
# You do not need to set this up. `mise run worker` declares svc:catalog and
# svc:payment, which deploy each callee and forward it to the port below. If you start
# one natively, the graph sees that the port answers and leaves it alone. This is how
# you debug the saga across all three services at once.
CATALOG_URL=http://localhost:8081
PAYMENT_URL=http://localhost:8084

# .mise.toml sets PORT from the registry, 8082 for orders. Uncomment to override it,
# because .env wins. Edit the registry instead when you can, so siblings agree.
# PORT=8082

# Uncomment these when you run an OTel collector locally. The lite deps have none.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
