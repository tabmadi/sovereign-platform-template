# Local inner-loop environment for `analytics`, per ADR-0200 and ADR-0205.
# Copy it to .env. `mise run server` and your IDE's debugger read it.
#
# Before you start, port-forward the deps to localhost and run the migrations:
#   mise run dev:forward     # in a separate terminal, keep it running
#   mise run migrate         # once per schema change

# Port-forwarded local Postgres, from infra/local/deps.yaml.
DATABASE_URL=postgres://dev:dev@localhost:5432/analytics?sslmode=disable

# The funnel definitions, per ADR-0700. The image holds them at
# /etc/analytics/funnels.yaml. A native run reads the repo copy.
FUNNELS_PATH=infra/analytics/funnels.yaml

# No OpenFGA and no Temporal. The render layer authorises the panel over this store,
# per ADR-0700. The rollup runs in the platform worker, and this service only
# answers the request that the worker makes.

# Uncomment these when you run an OTel collector locally. The lite deps have none.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
