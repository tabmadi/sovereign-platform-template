# Local inner-loop environment for the platform worker, per ADR-0302.
#
#   mise run dev:forward     # in a separate terminal
#   mise run worker

TEMPORAL_HOST_PORT=localhost:7233
TEMPORAL_NAMESPACE=default

# Where periodic obligations file their tracking issues. It is empty when no forge
# exists. Then the activity logs the issue it would file and does not fail. So a
# scheduled run does not stay red for a reason that nobody can fix.
FORGE_API_URL=

# Uncomment this when you run an OTel collector locally.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
