# The CI runner machine, per ADR-0102. Every value is a fact about a machine, and none is a secret.
# runner.sh reads this file, and infra/forge-host/forge.env for the forge it registers with.

# How a workstation reaches the runner machine, as `user@host`.
RUNNER_SSH=root@10.0.10.40
# Empty when the workstation reaches the runner directly. On a private network, the host that reaches it.
RUNNER_JUMP=root@198.51.100.2
# The runner's own address. BuildKit reaches the Actions cache on it from its own container, so loopback fails.
RUNNER_ADDRESS=10.0.10.40

# renovate: datasource=docker depName=data.forgejo.org/forgejo/runner
RUNNER_VERSION=13.0.0

# One job at a time. A machine has one registry port and one set of edge ports, so a second job that starts a
# cluster waits for the first, per ADR-0102.
INSTANCES=1
CACHE_PORT=40010
